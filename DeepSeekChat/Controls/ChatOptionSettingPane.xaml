<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeepSeekChat.Controls.ChatOptionSettingPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeepSeekChat.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DeepSeekChat.ViewModels"
    xmlns:dscc="using:DeepSeekChat.Controls"
    xmlns:conv="using:DeepSeekChat.Helper.Converters"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conv:IntyConverter x:Key="IntyConverter"/>
    </UserControl.Resources>
    <Grid BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Margin="24,32,0,0" Grid.Row="0" Style="{ThemeResource TitleTextBlockStyle}" x:Uid="ms-resource:///DiscussionPage/OptionsPanelHeader"/>
        <ScrollView Padding="24,0,24,32" Grid.Row="2">
            <StackPanel Spacing="16">
                <StackPanel.Resources>
                    <Style BasedOn="{StaticResource DefaultSliderStyle}" TargetType="Slider">
                        <Setter Property="Margin" Value="2,0"/>
                    </Style>
                </StackPanel.Resources>
                <dscc:OptionSettingItem x:Uid="ms-resource:///DiscussionPage/SystemPromptArgumentItem">
                    <dscc:OptionSettingItem.SubContent>
                        <Button HorizontalAlignment="Right" Command="{x:Bind DetailEditSystemPromptCommand}" x:Uid="ms-resource:///DiscussionPage/DetailEditSystemPromptButton"/>
                    </dscc:OptionSettingItem.SubContent>
                    <TextBox MaxHeight="200" Text="{x:Bind ChatOptionsViewModel.SystemPrompt, Mode=TwoWay}" TextWrapping="Wrap" Grid.Row="1" AcceptsReturn="True" MinHeight="70"/>
                </dscc:OptionSettingItem>
                <dscc:OptionSettingItem x:Uid="ms-resource:///DiscussionPage/MaxTokenOutputCountArgumentItem">
                    <dscc:OptionSettingItem.SubContent>
                        <NumberBox Maximum="16384" Minimum="1" HorizontalAlignment="Right" Value="{x:Bind ChatOptionsViewModel.MaxTokens, Mode=TwoWay}"/>
                    </dscc:OptionSettingItem.SubContent>
                    <Slider Value="{x:Bind ChatOptionsViewModel.MaxTokens, Mode=TwoWay}" Name="MaxTSlider" Grid.Row="1" Maximum="16384" Minimum="1"/>
                </dscc:OptionSettingItem>
                <dscc:OptionSettingItem x:Uid="ms-resource:///DiscussionPage/SeedArgumentItem">
                    <dscc:OptionSettingItem.SubContent>
                        <ToggleButton IsChecked="{x:Bind ChatOptionsViewModel.SeedAutoRefresh, Mode=TwoWay}" x:Uid="ms-resource:///DiscussionPage/AutoRefreshSeedToogleButton" HorizontalAlignment="Right" />
                    </dscc:OptionSettingItem.SubContent>
                    <Grid Grid.Row="1" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{x:Bind ChatOptionsViewModel.Seed, Mode=TwoWay}" x:Uid="ms-resource:///DiscussionPage/SeedInputBox" HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="1" VerticalAlignment="Stretch" Command="{x:Bind RandomSeedCommand}">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </Grid>
                </dscc:OptionSettingItem>
                <dscc:OptionSettingItem x:Uid="ms-resource:///DiscussionPage/TemperatureArgumentItem">
                    <dscc:OptionSettingItem.SubContent>
                        <NumberBox ValidationMode="Disabled" Maximum="1" Minimum="0" HorizontalAlignment="Right" Value="{x:Bind ChatOptionsViewModel.Temperature, Mode=TwoWay, Converter={StaticResource IntyConverter}, UpdateSourceTrigger=PropertyChanged}"/>
                    </dscc:OptionSettingItem.SubContent>
                    <Slider Value="{x:Bind ChatOptionsViewModel.Temperature, Mode=TwoWay, Converter={StaticResource IntyConverter}, UpdateSourceTrigger=PropertyChanged}" Name="TemptSlider" TickFrequency="0.1" StepFrequency="0.1" TickPlacement="None" Grid.Row="1" Maximum="2"/>
                </dscc:OptionSettingItem>
                <dscc:OptionSettingItem x:Uid="ms-resource:///DiscussionPage/TopPArgumentItem">
                    <dscc:OptionSettingItem.SubContent>
                        <NumberBox Maximum="1" Minimum="0.1" HorizontalAlignment="Right" Value="{x:Bind ChatOptionsViewModel.TopP, Mode=TwoWay, Converter={StaticResource IntyConverter}, ConverterParameter=2}"/>
                    </dscc:OptionSettingItem.SubContent>
                    <Slider Grid.Row="1" Value="{x:Bind ChatOptionsViewModel.TopP, Mode=TwoWay, Converter={StaticResource IntyConverter}, ConverterParameter=2}" Name="TopPSlider" TickFrequency="0.05" StepFrequency="0.05" TickPlacement="None" Maximum="1" Minimum="0.1"/>
                </dscc:OptionSettingItem>
                <dscc:OptionSettingItem x:Uid="ms-resource:///DiscussionPage/FrequencyPenaltyArgumentItem">
                    <dscc:OptionSettingItem.SubContent>
                        <NumberBox Maximum="2" Minimum="-2" HorizontalAlignment="Right" Value="{x:Bind ChatOptionsViewModel.FrequencyPenalty, Mode=TwoWay, Converter={StaticResource IntyConverter}}"/>
                    </dscc:OptionSettingItem.SubContent>
                    <Slider Value="{x:Bind ChatOptionsViewModel.FrequencyPenalty, Mode=TwoWay, Converter={StaticResource IntyConverter}}" Name="FPSlider" TickFrequency="0.1" StepFrequency="0.1" TickPlacement="None" Grid.Row="1" Minimum="-2" Maximum="2"/>
                </dscc:OptionSettingItem>
                <Grid>
                    <CheckBox IsChecked="{x:Bind ChatOptionsViewModel.StreamingOutput, Mode=TwoWay}" Grid.Row="0" x:Uid="ms-resource:///DiscussionPage/StreamingOutputOption"/>
                    <!--<TextBlock Grid.Row="1" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">*若使用流式输出，则活动/非活动文件选择上传功能将不可用</TextBlock>-->
                </Grid>

                <MenuFlyoutSeparator/>

                <TextBlock x:Uid="ms-resource:///DiscussionPage/ModOptionsHeader" Style="{ThemeResource BodyStrongTextBlockStyle}"/>

                <Grid Height="Auto" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox IsChecked="{x:Bind ChatOptionsViewModel.DetailedRequest, Mode=TwoWay}" Grid.Row="0">
                        <TextBlock x:Uid="ms-resource:///DiscussionPage/DetailedRequestArgumentOption"/>
                    </CheckBox>
                    <TextBlock x:Uid="ms-resource:///DiscussionPage/DetailedRequestArgumentOptionDescription" Grid.Row="1" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
            </StackPanel>
        </ScrollView>
    </Grid>
</UserControl>
