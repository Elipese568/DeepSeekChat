<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeepSeekChat.Controls.MessagesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeepSeekChat.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:vm="using:DeepSeekChat.ViewModels" 
    xmlns:tkuicont="using:CommunityToolkit.WinUI.UI.Controls" 
    xmlns:f="using:DeepSeekChat.Foundation"
    xmlns:conv="using:DeepSeekChat.Helper.Converters"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conv:ProgressStatusVisibilityConverter x:Key="ProgressStatusVisibilityConverter"/>
        <conv:EmptyVisibilityConverter x:Key="EmptyVisibilityConverter"/>
    </UserControl.Resources>
    <ListView SelectionMode="None" 
              Grid.Row="1" 
              x:Name="InvertedListView" 
              ItemsSource="{x:Bind MessagesSource.MessageViewModels, Mode=TwoWay}">
        <!-- The ItemsStackPanel must be edited to update the following two properties -->
        <!-- These properties allow the list to grow from the bottom -->
        <ListView.ItemsPanel>
            <ItemsPanelTemplate>
                <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" VerticalAlignment="Bottom"/>
            </ItemsPanelTemplate>
        </ListView.ItemsPanel>

        <!-- This setter property is created so ListViewItems correctly align to the left or right. -->
        <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>
        </ListView.ItemContainerStyle>

        <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:ApplicationChatMessageViewModel">
                <ListViewItem>
                    <ListViewItem.Resources>
                        <f:ReferenceValue Value="{x:Bind Mode=OneWay}" x:Key="Self"/>
                    </ListViewItem.Resources>
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <local:MessageItem Grid.Row="0" MessageSource="User" Side="Right" Content="{x:Bind UserPrompt,Mode=OneWay}">
                            <local:MessageItem.PaneBottomContent>
                                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                      BorderThickness="1" 
                                      CornerRadius="4"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      Padding="12"
                                      MaxWidth="300"
                                      Visibility="{x:Bind ReferMessage, Mode=OneWay, Converter={StaticResource EmptyVisibilityConverter}}"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" VerticalAlignment="Center" Glyph="&#xEE35;" FontSize="24" />
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1*" />
                                            <RowDefinition Height="1*" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ReferMessage.Metadata.Id}"/>
                                        <TextBlock Grid.Row="1"><Run x:Uid="ms-resource:///DiscussionPage/ReferPaneUserHeader"/> <Run Text="{x:Bind ReferMessage.UserPrompt}"/></TextBlock>
                                        <TextBlock Grid.Row="2"><Run x:Uid="ms-resource:///DiscussionPage/ReferPaneAIHeader"/> <Run Text="{x:Bind ReferMessage.AiChatCompletion.Content}"/></TextBlock>
                                    </Grid>
                                </Grid>
                            </local:MessageItem.PaneBottomContent>
                        </local:MessageItem>
                        <local:MessageItem Grid.Row="1" MessageSource="Assistant" Side="Left" Content="{x:Bind AiChatCompletion.Content, Mode=OneWay}">
                            <local:MessageItem.PaneTopContent>
                                <Expander IsExpanded="True"
                                          ExpandDirection="Down"
                                          VerticalAlignment="Top"
                                          HorizontalContentAlignment="Left">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                                    <Viewbox Width="16" Height="16" Margin="0,0,0,2">
                                                        <Grid>
                                                            <!-- 主盾牌路径 -->
                                                            <Path Fill="{ThemeResource TextFillColorPrimaryBrush}" Data="M2.656 17.344c-1.016-1.015-1.15-2.75-.313-4.925.325-.825.73-1.617 1.205-2.365L3.582 10l-.033-.054c-.5-.799-.91-1.596-1.206-2.365-.836-2.175-.703-3.91.313-4.926.56-.56 1.364-.86 2.335-.86 1.425 0 3.168.636 4.957 1.756l.053.034.053-.034c1.79-1.12 3.532-1.757 4.957-1.757.972 0 1.776.3 2.335.86 1.014 1.015 1.148 2.752.312 4.926a13.892 13.892 0 0 1-1.206 2.365l-.034.054.034.053c.5.8.91 1.596 1.205 2.365.837 2.175.704 3.911-.311 4.926-.56.56-1.364.861-2.335.861-1.425 0-3.168-.637-4.957-1.757L10 16.415l-.053.033c-1.79 1.12-3.532 1.757-4.957 1.757-.972 0-1.776-.3-2.335-.86zm13.631-4.399c-.187-.488-.429-.988-.71-1.492l-.075-.132-.092.12a22.075 22.075 0 0 1-3.968 3.968l-.12.093.132.074c1.308.734 2.559 1.162 3.556 1.162.563 0 1.006-.138 1.298-.43.3-.3.436-.774.428-1.346-.008-.575-.159-1.264-.449-2.017zm-6.345 1.65l.058.042.058-.042a19.881 19.881 0 0 0 4.551-4.537l.043-.058-.043-.058a20.123 20.123 0 0 0-2.093-2.458 19.732 19.732 0 0 0-2.458-2.08L10 5.364l-.058.042A19.883 19.883 0 0 0 5.39 9.942L5.348 10l.042.059c.631.874 1.332 1.695 2.094 2.457a19.74 19.74 0 0 0 2.458 2.08zm6.366-10.902c-.293-.293-.736-.431-1.298-.431-.998 0-2.248.429-3.556 1.163l-.132.074.12.092a21.938 21.938 0 0 1 3.968 3.968l.092.12.074-.132c.282-.504.524-1.004.711-1.492.29-.753.442-1.442.45-2.017.007-.572-.129-1.045-.429-1.345zM3.712 7.055c.202.514.44 1.013.712 1.493l.074.13.092-.119a21.94 21.94 0 0 1 3.968-3.968l.12-.092-.132-.074C7.238 3.69 5.987 3.262 4.99 3.262c-.563 0-1.006.138-1.298.43-.3.301-.436.774-.428 1.346.007.575.159 1.264.448 2.017zm0 5.89c-.29.753-.44 1.442-.448 2.017-.008.572.127 1.045.428 1.345.293.293.736.431 1.298.431.997 0 2.247-.428 3.556-1.162l.131-.074-.12-.093a21.94 21.94 0 0 1-3.967-3.968l-.093-.12-.074.132a11.712 11.712 0 0 0-.71 1.492z"/>
                                                            <!-- 中心圆点路径 -->
                                                            <Path Fill="{ThemeResource TextFillColorPrimaryBrush}" Data="M10.706 11.704A1.843 1.843 0 0 1 8.155 10a1.845 1.845 0 1 1 2.551 1.704z"/>
                                                        </Grid>
                                                    </Viewbox>
                                                    <TextBlock x:Uid="ms-resource:///DiscussionPage/DeepSeekingLabel"/>
                                                </StackPanel>
                                                <Border VerticalAlignment="Stretch"
                                                    Width="1"
                                                    BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Height="Auto"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" Spacing="2">
                                                    <Button Margin="0,2,0,0" VerticalAlignment="Stretch" Style="{StaticResource SubtleButtonStyle}">
                                                        <Button.Flyout>
                                                            <Flyout>
                                                                <!--Failded to assign to property 'DeepSeekChat.Controls.MessageTokenUsagePresenter.TokenUsageData'-->
                                                                <!--<local:MessageTokenUsagePresenter TokenUsageData="{x:Bind TokenUsage}"/>-->
                                                                <StackPanel Spacing="16">
                                                                    <local:PropertyPresenter x:Uid="ms-resource:///DiscussionPage/PromptTokenUsageFlyoutHeader" Value="{x:Bind TokenUsage.PromptTokens, Mode=OneWay}"/>
                                                                    <MenuFlyoutSeparator Margin="-12"/>
                                                                    <local:PropertyPresenter x:Uid="ms-resource:///DiscussionPage/CompletionTokenUsageFlyoutHeader" Value="{x:Bind TokenUsage.CompletionTokens, Mode=OneWay}"/>
                                                                </StackPanel>
                                                            </Flyout>
                                                        </Button.Flyout>
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock x:Uid="ms-resource:///DiscussionPage/TokenUsageHeader"/>
                                                            <TextBlock Text="{x:Bind TokenUsage.TotalTokens,Mode=OneWay}"/>
                                                            <TextBlock>token(s)</TextBlock>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Margin="0,2,0,0" VerticalAlignment="Stretch" Style="{StaticResource SubtleButtonStyle}">
                                                        <Button.Flyout>
                                                            <Flyout>
                                                                <local:MessageMetadataPresenter Metadata="{x:Bind Metadata,Mode=OneWay}"/>
                                                            </Flyout>
                                                        </Button.Flyout>
                                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                                            <Border CornerRadius="16" Width="16" Height="16" Background="{x:Bind ProgressStatus,Mode=OneWay, Converter={StaticResource ProgressStatusToColorConverter}}" />
                                                            <TextBlock Text="{x:Bind ProgressStatus,Mode=OneWay, Converter={StaticResource ProgressStatusToTextConverter}}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                                <Border VerticalAlignment="Stretch"
                                                    Width="1"
                                                    BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Height="Auto"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" Spacing="2">
                                                    <Button Padding="4" 
                                                        VerticalAlignment="Stretch"
                                                        Style="{ThemeResource SubtleButtonStyle}" 
                                                        Name="StopGeneratingButton" Click="StopGeneratingButton_Click" 
                                                        Visibility="{x:Bind ProgressStatus, Converter={StaticResource ProgressStatusVisibilityConverter}, Mode=OneWay}">
                                                        <FontIcon Margin="4,0" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Glyph="&#xE71A;" />
                                                    </Button>
                                                    <Button Padding="4" 
                                                        VerticalAlignment="Stretch"
                                                        Style="{ThemeResource SubtleButtonStyle}" 
                                                        Name="RemoveMessageButton" Click="RemoveMessageButton_Click"
                                                        Visibility="{x:Bind ProgressStatus, Converter={StaticResource ProgressStatusVisibilityConverter}, ConverterParameter=true, Mode=OneWay}">
                                                        <FontIcon Margin="4,0" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Glyph="&#xE74D;" />
                                                    </Button>
                                                    <Button Padding="4" 
                                                        VerticalAlignment="Stretch"
                                                        Style="{ThemeResource SubtleButtonStyle}" 
                                                        Name="ReferMessageButton" Click="ReferMessageButton_Click"
                                                        Visibility="{x:Bind ProgressStatus, Converter={StaticResource ProgressStatusVisibilityConverter}, ConverterParameter=true, Mode=OneWay}">
                                                        <FontIcon Margin="4,0" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Glyph="&#xE97A;" />
                                                    </Button>
                                                    <!--<Button Padding="4" 
                                                                    VerticalAlignment="Stretch"
                                                                    Style="{ThemeResource SubtleButtonStyle}" 
                                                                    Name="RegenerateMessageButton" Click="RegenerateMessageButton_Click"
                                                                    Visibility="{x:Bind ProgressStatus, Converter={StaticResource ProgressStatusVisibilityConverter}, ConverterParameter=true, Mode=OneWay}">
                                                                <FontIcon Margin="4,0" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Glyph="&#xE72C;" />
                                                            </Button>-->
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander.Header>
                                        <Expander.Content>
                                            <local:ResponseTextBlock Text="{x:Bind AiChatCompletion.ReasoningContent, Mode=OneWay}"/>
                                        </Expander.Content>
                                    </Expander>
                            </local:MessageItem.PaneTopContent>
                        </local:MessageItem>
                    </Grid>
                </ListViewItem>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</UserControl>
