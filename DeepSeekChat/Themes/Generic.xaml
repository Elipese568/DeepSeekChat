<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeepSeekChat"
    xmlns:local2="using:DeepSeekChat.Controls"
    xmlns:conv="using:DeepSeekChat.Helper.Converters"
    xmlns:tkuicont="using:CommunityToolkit.WinUI.UI.Controls" >
    
    <DataTemplate x:Key="PropertyPresenterTextHeaderTemplate">
        <TextBlock Text="{Binding}"
                   VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </DataTemplate>
    
    <Style TargetType="local2:PropertyPresenter">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local2:PropertyPresenter">
                    <StackPanel Spacing="8">
                        <ContentPresenter x:Name="PART_Header"/>
                        <TextBlock Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="TextMessageTemplate">
        <Grid CornerRadius="4" 
              Padding="12" 
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
              BorderThickness="1" 
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <TextBlock HorizontalAlignment="Right" 
                       IsTextSelectionEnabled="True" 
                       TextWrapping="Wrap" 
                       Text="{Binding}" />
        </Grid>
    </DataTemplate>

    <Style TargetType="local2:MessageItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local2:MessageItem">
                    <Grid ColumnSpacing="8" HorizontalAlignment="{TemplateBinding Side}" x:Name="PART_Root">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="PART_Content"/>

                        <PersonPicture ProfilePicture="{TemplateBinding AvatarSource}" 
                                       Height="32" 
                                       Width="32" 
                                       VerticalAlignment="Top" 
                                       HorizontalAlignment="Center" 
                                       BorderThickness="1"
                                       x:Name="PART_Avatar"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local2:OptionSettingItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local2:OptionSettingItem">
                    <Grid Height="Auto" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="{TemplateBinding Header}"/>
                        <ContentPresenter Grid.Row="0" HorizontalAlignment="Right" Content="{TemplateBinding SubContent}"/>
                        <ContentPresenter Grid.Row="1" HorizontalAlignment="Stretch" Content="{TemplateBinding Content}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <conv:EmptyVisibilityConverter x:Key="EmptyVisibilityConverter"/>
    <conv:FileSizeFriendlyStringConverter x:Key="FileSizeToFriendlyStringConverter"/>
    <conv:AnalyzeStatusToVisibilityConverter x:Key="AnalyzeStatusToVisibilityConverter"/>
    <conv:FileTypeToGlyphConverter x:Key="FileTypeToGlyphConverter"/>
    <DataTemplate x:Key="FileItemViewDataTemplate">
        <Grid Height="50" 
              Width="Auto" 
              IsDoubleTapEnabled="True" 
              DoubleTapped="FilePresent_DoubleTapped"
              Tag="{Binding}"
              ColumnSpacing="8" Padding="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <FontIcon Name="Icon" 
                  Grid.Column="0" 
                  Grid.Row="0" 
                  Grid.RowSpan="2" 
                  Glyph="{Binding Type, Converter={StaticResource FileTypeToGlyphConverter}}" 
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Center" 
                  Height="32" 
                  Width="32" 
                  FontSize="32"/>
            <Grid HorizontalAlignment="Stretch" Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{Binding Name}"/>
            </Grid>
            <Grid HorizontalAlignment="Stretch" Grid.Column="1" Grid.Row="1" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" 
                       HorizontalAlignment="Left" 
                       Margin="0,0,8,0" 
                       x:Name="AnalyzingText" 
                       Visibility="{Binding Status, Converter={StaticResource AnalyzeStatusToVisibilityConverter}, ConverterParameter=false}"
                       x:Uid="ms-resource:///DiscussionPage/AnalyzingCaptionTextBlock">
                </TextBlock>
                <TextBlock Grid.Column="1" 
                       HorizontalAlignment="Right" 
                       Style="{ThemeResource BodyTextBlockStyle}" 
                       Foreground="{ThemeResource TextFillColorSecondary}" 
                       Text="{Binding Size, Converter={StaticResource FileSizeToFriendlyStringConverter}}"/>
            </Grid>
        </Grid>
    </DataTemplate>
    
    <Style x:Key="ResponseMarkdownTextBlockStyle" TargetType="tkuicont:MarkdownTextBlock">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="IsTextSelectionEnabled" Value="True"/>
        <Setter Property="ParagraphLineHeight" Value="16"/>
    </Style>
    
    <Style TargetType="local2:ResponseTextBlock" xmlns:local2="using:DeepSeekChat.Controls">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local2:ResponseTextBlock">
                    <ContentPresenter x:Name="PART_Content"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
