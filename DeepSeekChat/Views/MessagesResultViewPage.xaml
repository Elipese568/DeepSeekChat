<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeepSeekChat.Views.MessagesResultViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeepSeekChat.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dscc="using:DeepSeekChat.Controls"
    mc:Ignorable="d">
    <Grid Padding="36,40" RowSpacing="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" HorizontalAlignment="Left" Style="{ThemeResource TitleTextBlockStyle}">
            <Run>"</Run><Run Text="{x:Bind ViewModel.QueryString}"/><Run>"</Run><Run x:Uid="ms-resource:///Searching/SearchResultItemCountDescriptionPrefix"/> <Run Text="{x:Bind ViewModel.DiscussionItemViewModel.Title}"/><Run x:Uid="ms-resource:///Searching/SearchResultItemCountDescriptionSuffix"/>
        </TextBlock>
        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="2,0,0,0" Grid.Row="0"><Run x:Uid="ms-resource:///MainPage/TotalMessageCountPrefix"/> <Run Text="{x:Bind ViewModel.MessagesViewModel.MessageViewModels.Count.ToString()}"/> <Run x:Uid="ms-resource:///MainPage/TotalMessageCountSuffix"/></TextBlock>
            <dscc:MessagesView Grid.Row="1" Mode="Previewing" GotoMessage="MessagesView_GotoMessage" MessagesSource="{x:Bind ViewModel.MessagesViewModel}"/>
        </Grid>
    </Grid>
</Page>
